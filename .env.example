# API Key for selected provider (only needed if using external AI)
AI_API_KEY=

# API Endpoint (if custom endpoint is required)
AI_ENDPOINT=

# Environment
VITE_ENV=development

# App Configuration
VITE_APP_NAME=ZONE SPORT - AI NEWS DESIGNER
VITE_APP_VERSION=1.0.0
